# Local: postgresql://usuario:senha@localhost:5432/expense_tracker
# Supabase/Neon: postgresql://postgres:SUA-SENHA@db.SEU-PROJETO.supabase.co:5432/postgres
DATABASE_URL=postgresql://usuario:senha@localhost:5432/expense_tracker

# true (padrão) para bancos hospedados como Supabase/Neon; false para Postgres local sem SSL
DATABASE_SSL=true

JWT_SECRET=troque-por-um-segredo-forte
PORT=3001
CORS_ORIGIN=http://localhost:5173

# URL do frontend, usada para montar o link de redefinição de senha no e-mail
FRONTEND_URL=http://localhost:5173

# Resend (envio de e-mail via API HTTPS — necessário porque hosts como o
# Render bloqueiam portas de SMTP no plano free). Crie uma conta grátis em
# resend.com e gere uma API key em Dashboard → API Keys.
RESEND_API_KEY=re_sua_api_key_aqui

# Remetente do e-mail. Sem domínio próprio verificado no Resend, use o
# domínio de teste deles (funciona sem configuração extra):
MAIL_FROM=FinPilot <onboarding@resend.dev>
